{
  "expo": {
    "name": "Weight Tracker",
    "slug": "weight-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "weighttracker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mi2odev.weighttracker",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mi2odev.weighttracker",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#2F6C7A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#17181A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Weight Tracker uses your photo library so you can attach progress photos to a measurement. They stay on this device.",
          "cameraPermission": "Weight Tracker uses the camera so you can take a progress photo. It stays on this device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Weight Tracker uses Face ID to keep your weight log private."
        }
      ]
    ]
  }
}
