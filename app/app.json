{
  "expo": {
    "name": "Weighpoint",
    "slug": "weighpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "weighpoint",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mi2odev.weighpoint",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mi2odev.weighpoint",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#015b5e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#015b5e",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#01383c"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Weighpoint uses your photo library so you can attach progress photos to a measurement. They stay on this device.",
          "cameraPermission": "Weighpoint uses the camera so you can take a progress photo. It stays on this device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Weighpoint uses Face ID to keep your weight log private."
        }
      ]
    ]
  }
}
